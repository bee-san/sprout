<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SPROUT"
        android:textColor="#355E49" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.15" />
    <TextView android:id="@+id/widget_activity" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Ready to grow" android:textSize="18sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" android:textColor="#24372C" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <Chronometer android:id="@+id/widget_clock" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="28sp" android:textColor="#24372C" />
        <TextView android:id="@+id/widget_stop" android:layout_width="64dp" android:layout_height="44dp"
            android:text="Stop" android:gravity="center" android:textStyle="bold" android:textColor="#355E49"
            android:background="@drawable/widget_button" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Add activities in Sprout to begin." android:textSize="13sp" android:textColor="#53624B" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <TextView android:id="@+id/widget_a1" android:text="Deep work" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:layout_marginEnd="4dp" android:background="@drawable/widget_button" android:gravity="center"
            android:textColor="#355E49" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_a2" android:text="Reading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:layout_marginStart="4dp" android:background="@drawable/widget_button" android:gravity="center"
            android:textColor="#355E49" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <TextView android:id="@+id/widget_a3" android:text="Learning" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:layout_marginEnd="4dp" android:background="@drawable/widget_button" android:gravity="center"
            android:textColor="#355E49" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_a4" android:text="A little walk" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:layout_marginStart="4dp" android:background="@drawable/widget_button" android:gravity="center"
            android:textColor="#355E49" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
